# Normalize line endings at commit time.
* text=auto

# Shell scripts must keep LF — CRLF breaks the shebang on the router.
*.sh    text eol=lf
*.mjs   text eol=lf
*.js    text eol=lf
*.json  text eol=lf
*.py    text eol=lf
*.md    text eol=lf
*.conf  text eol=lf
*.txt   text eol=lf

# PowerShell is happiest with CRLF on Windows.
*.ps1   text eol=crlf
